[Unit]
Description=白天每两小时查一次电费（不需要微信与 token）
Documentation=file:///opt/rest_electric/README.md

[Timer]
# 08:00–22:00 每 2 小时一次；夜里不查，减少无意义的登录
OnCalendar=*-*-* 08/2:07:00 Asia/Shanghai
# 0-10 分钟随机抖动，避免固定秒级特征
RandomizedDelaySec=600
AccuracySec=1min
# 断网/关机期间错过的执行，开机后补跑一次
Persistent=true
Unit=rest-electric.service

[Install]
WantedBy=timers.target
