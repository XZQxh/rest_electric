[Unit]
Description=每天三次网页版查询（不需要微信与 token）
Documentation=file:///opt/rest_electric/README.md

[Timer]
# 网页版通道没有 2 小时 token 限制，按天采点即可
OnCalendar=*-*-* 08,14,20:07:00 Asia/Shanghai
# 0-5 分钟随机抖动，避免固定秒级特征
RandomizedDelaySec=300
AccuracySec=1min
# 断网/关机期间错过的执行，开机后补跑一次
Persistent=true
Unit=rest-electric.service

[Install]
WantedBy=timers.target
